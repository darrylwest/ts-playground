{
  "name": "valkey-spaces-database",
  "version": "1.0.0",
  "description": "Hybrid database combining Valkey caching with S3 persistence",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "create-user": "node dist/cli/index.js create-user",
    "find-user": "node dist/cli/index.js find-user",
    "get-user": "node dist/cli/index.js get-user",
    "update-user": "node dist/cli/index.js update-user",
    "list-users": "node dist/cli/index.js list-users",
    "get-user-count": "node dist/cli/index.js get-user-count",
    "verify-email-index": "node dist/cli/index.js verify-email-index",
    "rebuild-email-index": "node dist/cli/index.js rebuild-email-index",
    "health-check": "node dist/cli/index.js health-check"
  },
  "dependencies": {
    "zod": "^3.22.0",
    "iovalkey": "^1.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.0",
    "@dotenvx/dotenvx": "^0.10.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "prettier": "^3.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "pm2": "^5.3.0"
  },
  "keywords": [
    "valkey",
    "redis",
    "s3",
    "database",
    "typescript",
    "cli"
  ],
  "author": "dpw",
  "license": "MIT"
}